# Personal build: the API key is passed through from the client's own request
# headers on every call. There is no stored key and nothing to configure here —
# a request without a key gets a local 401.

# Proxy config
HOST=127.0.0.1
PORT=8787

# Upstream API base (override only for testing against a mock)
# CC_API_BASE=https://api.commandcode.ai

# CLI version sent upstream. CC blocks requests whose version looks stale, so
# this is refreshed from the npm registry at startup unless set explicitly.
# CC_CLI_VERSION=0.40.3

# Upstream timeouts (milliseconds)
# Bounds the TCP/TLS connect and the request write (NOT the read: see the two
# variables below, which govern how long the proxy waits for data).
# CC_UPSTREAM_TIMEOUT_MS=600000   # default: 10 minutes

# Max gap between consecutive data chunks during streaming. If CC opens the
# connection but stops sending data mid-response (stalled tool call, dropped
# TCP, etc.), the proxy aborts the stream and the client gets a clean
# error/finish instead of hanging forever. Set to 0 to disable.
# CC_IDLE_TIMEOUT_MS=120000       # default: 2 minutes

# Fast retry for a bad network: how long an attempt may produce *no bytes at
# all* before the proxy discards it and re-sends from scratch. Only applies
# before the first byte — once anything has arrived, CC_IDLE_TIMEOUT_MS governs
# instead (re-sending after output would duplicate what the client already saw).
# CC_NO_OUTPUT_TIMEOUT_MS=30000   # default: 30 seconds; 0 disables

# How many times a silent attempt is re-sent before the client is told.
# Total upstream requests per client request is this + 1.
# CC_NO_OUTPUT_RETRIES=3          # default: 3 (max 10); 0 disables

# Max request body size. Raise for large vision/PDF payloads.
# CC_MAX_BODY_BYTES=10485760      # default: 10 MiB (capped at 50 MiB)

# --- Failure classification -------------------------------------------------
# Upstream failures are logged and recorded with a class tag, so the ways a
# request can fail are distinguishable at a glance:
#   [transport-header-timeout]   the answer never started arriving
#   [transport-connect-timeout]  the connection was never established
#   [transport-refused]          the socket was actively refused
#   [transport-dns]              the name did not resolve
#   [transport-reset]            the connection dropped mid-flight
#   [transport-proxy]            the configured egress proxy failed
# Once output has begun a different set applies — [no-output], [idle-timeout],
# [connection-reset], [upstream-error], [bad-upstream-data], [client-gone] —
# because a stall after the client has seen part of the answer is a different
# problem from a request that never started. The class is read from the error's
# structure, not its text, so it does not depend on the OS language. The same
# string is the ledger's errorTag. See docs/adr/0001.
#
# Note on the timeouts above: the header wait and the body-stall window share
# ONE socket read timeout (ureq applies one per connection and cannot change it
# after the headers arrive), so the effective header deadline is the smallest
# deadline you set here. Do not lower these expecting a tighter check: a value
# below what a real request needs to answer fails every request.

# Set to "off" to stop injecting the "tools are disabled" instruction into
# tool-less chat requests.
# CC_NO_TOOLS_GUARD=on

# Which CC model every `claude-*` request resolves to.
# ANTHROPIC_DEFAULT_MODEL=deepseek/deepseek-v4-pro

# Log level: debug | info | warn | error
# LOG_LEVEL=info

# CORS. `*` is fine for localhost; set an explicit origin before exposing on a
# network, or leave empty to disable CORS entirely.
# CORS_ORIGIN=*

# Tray only: force a direct upstream connection (Tray reads the Windows system
# proxy by default). Use CC_PROXY=<url> to override with an explicit proxy.
#
# The outbound-proxy policy normally lives in ccproxy.json (beside the proxy
# exe): "default" probes the system proxy and falls back to direct, "direct"
# never proxies, and a URL always proxies with no fallback. CC_PROXY overrides
# that file, so it stays honoured here.
# CC_PROXY=off

# Personal build: the API key is passed through from the client's own request
# headers on every call. There is no stored key and nothing to configure here —
# a request without a key gets a local 401.

# Proxy config
HOST=127.0.0.1
PORT=8787

# Upstream API base (override only for testing against a mock)
# CC_API_BASE=https://api.commandcode.ai

# CLI version sent upstream. CC blocks requests whose version looks stale, so
# this is refreshed from the npm registry at startup unless set explicitly.
# CC_CLI_VERSION=0.40.3

# Upstream timeouts (milliseconds)
# Max wall-clock time for CC to return response headers + first byte.
# Bump this for slow reasoning models that take a while to start streaming.
# CC_UPSTREAM_TIMEOUT_MS=600000   # default: 10 minutes

# Max gap between consecutive data chunks during streaming. If CC opens the
# connection but stops sending data mid-response (stalled tool call, dropped
# TCP, etc.), the proxy aborts the stream and the client gets a clean
# error/finish instead of hanging forever. Set to 0 to disable.
# CC_IDLE_TIMEOUT_MS=120000       # default: 2 minutes

# Max request body size. Raise for large vision/PDF payloads.
# CC_MAX_BODY_BYTES=10485760      # default: 10 MiB (capped at 50 MiB)

# Set to "off" to stop injecting the "tools are disabled" instruction into
# tool-less chat requests.
# CC_NO_TOOLS_GUARD=on

# Which CC model every `claude-*` request resolves to.
# ANTHROPIC_DEFAULT_MODEL=deepseek/deepseek-v4-pro

# Log level: debug | info | warn | error
# LOG_LEVEL=info

# CORS. `*` is fine for localhost; set an explicit origin before exposing on a
# network, or leave empty to disable CORS entirely.
# CORS_ORIGIN=*

# Tray only: force a direct upstream connection (Tray reads the Windows system
# proxy by default). Use CC_PROXY=<url> to override with an explicit proxy.
# CC_PROXY=off

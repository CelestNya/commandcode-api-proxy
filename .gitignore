# Build output
/target/
release/

# cargo-deb staging (release workflow copies packaging assets under each
# crate's pkg/ before packaging; never committed)
crates/*/pkg/

# Runtime state (never committed: logs, ledgers, request dumps live here)
logs/
*.log

# Local environment / config
.env
.env.local

# The outbound-proxy policy is per-install: a real service/ccproxy.json
# reflects one machine's proxy and must not be committed. The annotated
# template is ccproxy.example.json.
service/ccproxy.json

# Editors / OS
.DS_Store
__pycache__/

# Tool session state (not project content)
.zcode/
# Verification screenshots and probe scripts live under .probe/ — never in the
# repository root, which stays reserved for tracked project content.
.probe/shots/
# Ad-hoc API dumps written by the probes (the fixture data-light/ stays).
.probe/*.json
# Runtime state of the probe instance (pid file, refreshed price cache).
.probe/data-light/ccproxy.pid
.probe/data-light/pricing.json
# Third-party checkouts the probes clone for reference (not project content).
.probe/ref/

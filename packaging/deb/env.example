# commandcode-proxy environment overrides.
# The deb installs this file as /etc/commandcode-proxy/env.example and copies
# it to /etc/commandcode-proxy/env on first install; the systemd unit reads it
# via EnvironmentFile. All values are optional — the code falls back to XDG
# layout and default port 8787. Uncomment to override.
#
#PORT=8787
#CC_WEBUI_DIR=/usr/share/commandcode-proxy/webui
#CC_DATA_DIR=/var/lib/commandcode-proxy
#CC_LOG_DIR=/var/log/commandcode-proxy
#CC_TRAY_NS=default

# Maintainer: CelestNya <celestnya@users.noreply.github.com>
# Precompiled release binary ("-bin"): no kernel involvement, so no rebuild.
# Generated by the release workflow (packaging/aur/render-pkgbuild.sh) with
# the real version and tarball sha256; keep the two in step.

pkgname=commandcode-proxy-bin
pkgver=@PKGVER@
pkgrel=@PKGREL@
pkgdesc="API translation proxy for commandcode.ai (precompiled)"
arch=('x86_64')
url="https://github.com/CelestNya/commandcode-api-proxy"
license=('MIT')
depends=('glibc')
provides=('commandcode-proxy')
conflicts=('commandcode-proxy')
source=("commandcode-proxy-${pkgver}-linux-x86_64.tar.gz::https://github.com/CelestNya/commandcode-api-proxy/releases/download/v${pkgver}/commandcode-proxy-${pkgver}-linux-x86_64.tar.gz")
sha256sums=('@SHA256@')

package() {
  cd "${srcdir}"
  install -Dm755 usr/bin/commandcode-proxy "$pkgdir/usr/bin/commandcode-proxy"
  install -Dm755 usr/bin/commandcode-proxy-tray "$pkgdir/usr/bin/commandcode-proxy-tray"
  install -Dm644 usr/lib/systemd/system/commandcode-proxy.service \
      "$pkgdir/usr/lib/systemd/system/commandcode-proxy.service"
  install -Dm644 usr/share/applications/commandcode-proxy-tray.desktop \
      "$pkgdir/usr/share/applications/commandcode-proxy-tray.desktop"
  install -Dm644 usr/share/icons/hicolor/scalable/apps/commandcode-proxy.svg \
      "$pkgdir/usr/share/icons/hicolor/scalable/apps/commandcode-proxy.svg"
  cp -r usr/share/commandcode-proxy/webui "$pkgdir/usr/share/commandcode-proxy/"
  install -Dm640 etc/commandcode-proxy/env.example \
      "$pkgdir/etc/commandcode-proxy/env.example"
}

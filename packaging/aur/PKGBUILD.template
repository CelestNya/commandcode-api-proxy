# Maintainer: CelestNya <celestnya@users.noreply.github.com>
# Precompiled release binary ("-bin"): no kernel involvement, so no rebuild.
# Generated by the release workflow (packaging/aur/verify-aur.sh) with the
# real version and tarball sha256; keep the two in step.
#
# The FHS tree (usr/, lib/, etc/) comes straight out of the xtask-produced
# tarball — there is no second per-file list here. Adding/removing a file in
# packaging/layout.toml is enough; do not maintain a parallel install list.

pkgname=commandcode-proxy-bin
pkgver=@PKGVER@
pkgrel=@PKGREL@
pkgdesc="API translation proxy for commandcode.ai (precompiled)"
arch=('x86_64')
url="https://github.com/CelestNya/commandcode-api-proxy"
license=('MIT')
depends=('glibc')
provides=('commandcode-proxy')
conflicts=('commandcode-proxy')
source=("commandcode-proxy-${pkgver}-linux-x86_64.tar.gz::https://github.com/CelestNya/commandcode-api-proxy/releases/download/v${pkgver}/commandcode-proxy-${pkgver}-linux-x86_64.tar.gz")
sha256sums=('@SHA256@')

package() {
  cd "${srcdir}"
  # Lay down the whole FHS tree as staged by xtask (usr/bin, usr/share/webui,
  # lib/systemd/system, etc/commandcode-proxy). cp -a preserves modes.
  cp -a usr lib etc "${pkgdir}/"
}
